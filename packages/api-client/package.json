{
  "name": "@ncanny/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the Ncanny API, shared by the web and mobile applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@ncanny/types": "workspace:*",
    "@ncanny/validation": "workspace:*"
  },
  "devDependencies": {
    "@ncanny/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
