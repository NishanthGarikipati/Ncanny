{
  "name": "@ncanny/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain types, enums and API contracts for Ncanny",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@ncanny/types: type-only package, covered by typecheck\""
  },
  "devDependencies": {
    "@ncanny/config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
