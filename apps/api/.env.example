# Ncanny API configuration.
# Copy to .env and fill in. Never commit a populated .env file.

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api

# Database -------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ncanny
MONGODB_DB_NAME=ncanny

# Authentication -------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The API refuses to start in production if this is left at a development value.
JWT_SECRET=development-only-insecure-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# One-time codes -------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Returns the code in the API response so the OTP flow can be exercised without
# an SMS provider. Forced off in production.
OTP_EXPOSE_DEBUG_CODE=true

# HTTP -----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# Observability --------------------------------------------------------------
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Media ----------------------------------------------------------------------
# Directory for uploaded images and audio. Defaults to the OS temp directory
# under ncanny-media when unset. This is local disk, not object storage.
# MEDIA_ROOT=
